  "themeColor": {
    "city": "#F4EFE3",
    "forest": "#E6DABF",
    "ocean": "#E6EEF2",
    "space": "#1C211F"
  },
  "font": {
    "display": {
      "stack": "\"Bricolage Grotesque\", \"Arial Black\", system-ui, sans-serif",
      "file": "fonts/BricolageGrotesque-Variable.woff2",
      "weight": "400 800"
    },
    "ui": {
      "stack": "\"Atkinson Hyperlegible Next\", \"Atkinson Hyperlegible\", system-ui, sans-serif",
      "file": "fonts/AtkinsonHyperlegibleNext-Variable.woff2",
      "weight": "200 800"
    },
    "mono": {
      "stack": "\"Spline Sans Mono\", ui-monospace, \"SF Mono\", monospace",
      "file": "fonts/SplineSansMono-Variable.woff2",
      "weight": "300 700"
    }
  },
  "text": {
    "display-name": {
      "fontSize": "44px",
      "lineHeight": "44px",
      "fontWeight": 800,
      "letterSpacing": "-0.02em",
      "family": "display"
    },
    "display-word": {
      "fontSize": "40px",
      "lineHeight": "44px",
      "fontWeight": 800,
      "letterSpacing": "-0.01em",
      "family": "display"
    },
    "title-lg": {
      "fontSize": "34px",
      "lineHeight": "36px",
      "fontWeight": 800,
      "letterSpacing": "-0.01em",
      "family": "display"
    },
    "title-md": {
      "fontSize": "22px",
      "lineHeight": "26px",
      "fontWeight": 800,
      "family": "display"
    },
    "title-sm": {
      "fontSize": "18px",
      "lineHeight": "22px",
      "fontWeight": 800,
      "family": "display"
    },
    "body": {
      "fontSize": "16px",
      "lineHeight": "23px",
      "fontWeight": 400,
      "family": "ui"
    },
    "body-sm": {
      "fontSize": "14px",
      "lineHeight": "20px",
      "fontWeight": 400,
      "family": "ui"
    },
    "button": {
      "fontSize": "18px",
      "lineHeight": "22px",
      "fontWeight": 800,
      "family": "ui"
    },
    "input": {
      "fontSize": "20px",
      "lineHeight": "26px",
      "fontWeight": 600,
      "family": "ui"
    },
    "label": {
      "fontSize": "12px",
      "lineHeight": "16px",
      "fontWeight": 700,
      "letterSpacing": "0.14em",
      "family": "ui"
    },
    "counter": {
      "fontSize": "15px",
      "lineHeight": "20px",
      "fontWeight": 700,
      "family": "mono"
    },
    "index": {
      "fontSize": "13px",
      "lineHeight": "16px",
      "fontWeight": 700,
      "family": "mono"
    }
  },
  "space": {
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "20px",
    "space-6": "24px",
    "space-8": "32px",
    "margin-inset": "30px",
    "content-inset": "44px"
  },
  "radius": {
    "radius-xs": "3px",
    "radius-sm": "4px",
    "radius-md": "6px",
    "radius-round": "999px"
  },
  "border": {
    "border-hair": "1.5px",
    "border-ui": "2.5px",
    "border-heavy": "3.5px"
  },
  "tilt": {
    "tilt-tape": "-2deg",
    "tilt-stamp": "-12deg"
  },
  "motion": {
    "t-press": "80ms",
    "t-stamp": "180ms",
    "ease-press": "linear"
  },
  "legacy": {
    "$description": "Alte Variablen aus index.html, auf neue Tokens umgeleitet. Nach der Migration löschen.",
    "--bg": "var(--paper-sunk)",
    "--app-bg": "var(--paper)",
    "--surface": "var(--paper-raised)",
    "--surface-2": "var(--paper-sunk)",
    "--surface-3": "var(--paper-sunk)",
    "--text": "var(--ink)",
    "--text-dim": "var(--ink-muted)",
    "--text-soft": "var(--line-soft)",
    "--primary": "var(--marker)",
    "--primary-ink": "var(--on-marker)",
    "--primary-soft": "var(--paper-sunk)",
    "--accent": "var(--ink)",
    "--accent-2": "var(--correct)",
    "--border": "var(--ink)",
    "--shadow": "rgba(0,0,0,0)",
    "--texture": "none",
    "--texture-size": "auto",
    "--star": "transparent",
    "--r-sm": "var(--radius-sm)",
    "--r-md": "var(--radius-md)",
    "--r-lg": "var(--radius-md)",
    "--r-xl": "var(--radius-md)",
    "--r-pill": "var(--radius-md)",
    "--ease": "cubic-bezier(.2,0,0,1)"
  }
}